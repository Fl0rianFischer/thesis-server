# Copy to .env for local testing. Never commit .env.
#
# On the box this file is written by the deploy workflow — don't edit it there,
# change the GitHub secret or variable and redeploy.
#
# Format is Compose env_file: bare KEY=value, no `export` prefix and no shell
# expansion. To load it into your own shell for a non-Docker run:
#   set -a; . ./.env; set +a

# Which image tag Compose runs. Use `local` when testing a locally built image.
IMAGE_TAG=local

# THE only timezone in this project. It decides when the briefing runs, what
# date the file is named for, the mail subject, and the agent's own sense of
# what time it is and how long ago the US session closed. The host's timezone
# is deliberately not consulted anywhere — moving country means changing this
# one line and redeploying.
#
# Must be a tz database name (Asia/Jakarta, Europe/Berlin). An empty or
# misspelled value silently means UTC, so the deploy refuses both.
TZ=Asia/Jakarta

# Subscription OAuth token, valid for ONE YEAR. Generate on a machine with a
# browser:
#   claude setup-token
# It prints the token once and saves it nowhere. Requires Pro, Max, Team, or
# Enterprise, and draws on the usage limits of whoever generated it.
#
# Only needed for the container — a bare `./run.sh` on your laptop uses your
# existing interactive Claude Code login instead.
CLAUDE_CODE_OAUTH_TOKEN=

# Date you ran `claude setup-token` (YYYY-MM-DD). Optional but recommended:
# the token expires silently — Claude Code's "login expires in 3 days" warning
# does not fire for CLAUDE_CODE_OAUTH_TOKEN — so run.sh uses this to warn you a
# month out. Otherwise the first symptom is a briefing that stops arriving.
CLAUDE_TOKEN_ISSUED=

# Do NOT set ANTHROPIC_API_KEY or ANTHROPIC_AUTH_TOKEN here. Both outrank
# CLAUDE_CODE_OAUTH_TOKEN in Claude Code's auth precedence, so either one
# silently moves the run onto API billing. run.sh warns if it sees them.

# Email delivery (Resend). Leave RESEND_API_KEY empty while tuning the prompt:
# run.sh then writes the briefing and skips the send.
RESEND_API_KEY=
MAIL_FROM=briefing@yourdomain.example
MAIL_TO=you@example.com

# sonnet is the default: lighter on subscription usage limits, and roughly half
# the cost of opus if you ever switch to API billing. Try opus if output is thin.
BRIEFING_MODEL=sonnet
BRIEFING_EFFORT=medium
BRIEFING_MAX_TURNS=40

# The schedule, expressed in TZ above rather than in cron syntax. cron fires
# tick.sh every 15 minutes and tick.sh decides whether it is briefing time, so
# nothing about the schedule depends on the host's clock. Days are 1-7 with
# Monday as 1; "1-5", "1,3,5" and "1-3,6" all work.
BRIEFING_HOUR=5
BRIEFING_DAYS=1-5

# How many times tick.sh retries a failing run before giving up for the day.
# Without a cap, a broken run (an expired token, say) would retry every 15
# minutes until midnight and empty a month of usage limits in one morning.
BRIEFING_MAX_ATTEMPTS=3
