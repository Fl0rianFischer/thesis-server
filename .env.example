# Copy to .env on the box and fill in. Never commit .env.
# Sourced by cron before run.sh, so it must be valid shell.

# Cron's PATH is nearly empty. Point this at wherever `which claude` reports
# on the box, plus the basics.
export PATH="/usr/local/bin:/usr/bin:/bin:$HOME/.local/bin"

# Long-lived subscription token. Generate on a machine with a browser:
#   claude setup-token
# It prints the token and does not save it — copy it here.
# Verify on the box with: claude auth status --text
export CLAUDE_CODE_OAUTH_TOKEN=""

# Email delivery (Resend). Header-based auth, works fine from a script.
export RESEND_API_KEY=""
export MAIL_FROM="briefing@yourdomain.example"
export MAIL_TO="you@example.com"

# Optional overrides.
# sonnet is the default: roughly half the cost of opus on API billing, and a
# lighter draw on subscription usage limits. Switch to opus if the output is
# thin.
export BRIEFING_MODEL="sonnet"
export BRIEFING_EFFORT="medium"
export BRIEFING_MAX_TURNS="40"
